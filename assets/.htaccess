# Nada nesta pasta deve ser interpretado como PHP.
# Se um dia um arquivo indevido for parar aqui — por engano de copia ou por um
# envio que escape da validacao — ele nao vira codigo executavel no servidor.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Desliga o interpretador na pasta inteira, para o caso de a regra acima ser
# contornada por uma extensao dupla do tipo "imagem.php.png".
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

Options -Indexes
