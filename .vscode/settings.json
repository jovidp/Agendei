{
    // ---------- Editor ----------
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [120],
    "editor.bracketPairColorization.enabled": true,
    "editor.linkedEditing": true,
    "editor.formatOnSave": false, // ligue por linguagem abaixo para nao reformatar arquivos legados inteiros

    // ---------- Arquivos ----------
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
        "*.php": "php",
        ".htaccess": "apacheconf"
    },

    // ---------- PHP ----------
    // Desliga o autocomplete basico embutido para nao duplicar o do Intelephense
    "php.suggest.basic": false,
    "intelephense.environment.phpVersion": "8.2.0",
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/vendor/**/{Tests,tests}/**"
    ],
    "intelephense.diagnostics.undefinedVariables": true,
    "intelephense.format.braces": "k&r",
    "[php]": {
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },

    // ---------- Frontend ----------
    "emmet.includeLanguages": {
        "php": "html"
    },
    "css.lint.unknownAtRules": "ignore",
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "prettier.tabWidth": 4,
    "prettier.singleQuote": true,
    "prettier.printWidth": 120,
    "prettier.endOfLine": "crlf",

    // ---------- Busca / explorer ----------
    "search.exclude": {
        "**/vendor": true,
        "**/node_modules": true,
        "**/.git": true
    },
    "files.watcherExclude": {
        "**/vendor/**": true,
        "**/node_modules/**": true
    },

    // ---------- Error Lens ----------
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.excludeBySource": ["cSpell"],

    // ---------- Todo Tree ----------
    "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE"],

    // ---------- Corretor ortografico ----------
    "cSpell.language": "en,pt,pt-BR",
    "cSpell.words": [
        "agendei",
        "agendamentos",
        "estabelecimento",
        "estabelecimentos",
        "profissionais",
        "profissional",
        "servicos",
        "horarios",
        "diferenciais",
        "aparencia",
        "configuracoes",
        "relatorios",
        "privacidade",
        "beneficios",
        "historico",
        "cadastro",
        "recuperar",
        "redefinir",
        "instalar",
        "icones",
        "funcoes",
        "calendario"
    ]
}
